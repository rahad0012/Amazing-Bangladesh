rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email in ["bluesky90987@gmail.com", "mdrahad0529@gmail.com"] && request.auth.token.email_verified == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Public read for published tourism content; write by admins
    match /divisions/{divisionId} {
      allow read: if isValidId(divisionId);
      allow write: if isAdmin();
    }

    match /districts/{districtId} {
      allow read: if isValidId(districtId);
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isValidId(categoryId);
      allow write: if isAdmin();
    }

    match /tourist_spots/{spotId} {
      allow read: if isValidId(spotId);
      allow write: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if isValidId(articleId);
      allow write: if isAdmin();
    }

    match /media/{mediaId} {
      allow read: if isValidId(mediaId);
      allow write: if isAdmin();
    }

    match /site_settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /newsletter_subscribers/{subId} {
      allow create: if isValidId(subId) && 
        request.resource.data.email is string && 
        request.resource.data.email.size() <= 128 &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
      allow read, delete: if isAdmin();
    }
  }
}
