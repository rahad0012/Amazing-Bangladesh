rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminEmail() {
      return isSignedIn() &&
        request.auth.token.email in ["bluesky90987@gmail.com", "mdrahad0529@gmail.com"] &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        isAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Public read for published tourism content; list enforces is_published == true or admin email
    match /divisions/{divisionId} {
      allow get: if isValidId(divisionId) && (resource.data.is_published == true || isAdmin());
      allow list: if resource.data.is_published == true || isAdminEmail();
      allow write: if isValidId(divisionId) && isAdmin();
    }

    match /districts/{districtId} {
      allow get: if isValidId(districtId) && (resource.data.is_published == true || isAdmin());
      allow list: if resource.data.is_published == true || isAdminEmail();
      allow write: if isValidId(districtId) && isAdmin();
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId) && (resource.data.is_published == true || isAdmin());
      allow list: if resource.data.is_published == true || isAdminEmail();
      allow write: if isValidId(categoryId) && isAdmin();
    }

    match /tourist_spots/{spotId} {
      allow get: if isValidId(spotId) && (resource.data.is_published == true || isAdmin());
      allow list: if resource.data.is_published == true || isAdminEmail();
      allow write: if isValidId(spotId) && isAdmin();
    }

    match /articles/{articleId} {
      allow get: if isValidId(articleId) && (resource.data.is_published == true || isAdmin());
      allow list: if resource.data.is_published == true || isAdminEmail();
      allow write: if isValidId(articleId) && isAdmin();
    }

    match /media/{mediaId} {
      allow get: if isValidId(mediaId);
      allow list: if true;
      allow write: if isValidId(mediaId) && isAdmin();
    }

    match /site_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow write: if isValidId(settingId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAdmin();
      allow list: if isAdminEmail();
      allow write: if isValidId(adminId) && isAdmin();
    }

    match /newsletter_subscribers/{subId} {
      allow create: if isValidId(subId) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 128 &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
      allow get: if isValidId(subId) && isAdmin();
      allow list: if isAdminEmail();
      allow delete: if isValidId(subId) && isAdmin();
    }
  }
}
